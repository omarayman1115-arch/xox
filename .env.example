# انسخ الملف ده باسم ".env.local" واملأ القيم من لوحة Supabase
# Copy this file to ".env.local" and fill in the values from your Supabase dashboard

# من Supabase > Project Settings > API
# مفتاح النشر (بيقرأ بس — آمن يتحط في المتصفح)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# المفتاح السري (بيكتب — للسيرفر بس) — ممنوع ينشر أبداً!
SUPABASE_SECRET_KEY=YOUR-SECRET-KEY

# كلمة سر لوحة التحكم (غيّرها بكلمة سر قوية)
ADMIN_PASSWORD=change-me-to-a-strong-password

# رقم الواتساب/الموبايل الافتراضي (مصر +20)
NEXT_PUBLIC_DEFAULT_WHATSAPP=201151707244
